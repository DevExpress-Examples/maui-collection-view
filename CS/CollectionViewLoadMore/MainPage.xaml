<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:local="clr-namespace:InfiniteScrollingExample"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             ios:Page.UseSafeArea="true"
             x:Class= "InfiniteScrollingExample.MainPage"
             BindingContext="{dx:Ioc Type={x:Type local:MainViewModel}}"
             BackgroundColor="{dx:ThemeColor Surface}"
             x:DataType="local:MainViewModel">
    <Grid>
        <dx:DXCollectionView ItemsSource="{Binding Blogs}" 
                             IsRefreshing="{Binding IsLoading, Mode=TwoWay}" 
                             IsLoadMoreEnabled="True" 
                             LoadMoreCommand="{Binding LoadMoreCommand}" 
                             TapCommand="{Binding OpenBlogCommand}">
            <dx:DXCollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type local:BlogPost}">
                    <dx:DXStackLayout Orientation="Vertical" 
                                      Margin="0,8,0,8">
                        <dx:DXBorder CornerRadius="20" 
                                     Margin="16,0,16,10">
                            <dx:DXImage Source="{Binding ImagePath}" 
                                        Aspect="AspectFill" 
                                        HeightRequest="200"/>
                        </dx:DXBorder>
                        <Label Text="{Binding Title}" 
                               TextColor="{dx:ThemeColor OnSurface}" 
                               FontSize="18" 
                               MaxLines="3" 
                               LineBreakMode="WordWrap" 
                               Margin="16,0,16,10"/>
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" 
                              Margin="16,0,16,0">
                            <dx:DXImage Source="{Binding AvatarPath}" 
                                        WidthRequest="24" 
                                        HeightRequest="24">
                                <dx:DXImage.Clip>
                                    <EllipseGeometry RadiusX="12" 
                                                     RadiusY="12" 
                                                     Center="12,12"/>
                                </dx:DXImage.Clip>
                            </dx:DXImage>
                            <Label Text="{Binding AuthorName}" 
                                   VerticalOptions="Center" 
                                   TextColor="{dx:ThemeColor OnSurfaceVariant}" 
                                   Margin="5,0,0,0" Grid.Column="1"/>
                            <Label Text="{Binding PublicationDate, StringFormat=' &#8226; {0:m}'}" 
                                   TextColor="{dx:ThemeColor OnSurfaceVariant}" 
                                   VerticalOptions="Center" 
                                   Grid.Column="2"/>
                            <dx:DXButton Command="{Binding Source={RelativeSource Mode=FindAncestorBindingContext, AncestorType={x:Type local:MainViewModel}}, Path=ShareBlogCommand}"
                                         CommandParameter="{Binding}"
                                         BackgroundColor="Transparent"
                                         IconColor="{dx:ThemeColor OnSurfaceVariant}"
                                         Margin="10,0,0,0" 
                                         Padding="4,0,4,0" 
                                         WidthRequest="28" 
                                         VerticalOptions="Center"
                                         Icon="share"
                                         Grid.Column="3"/>
                        </Grid>
                        <dx:DXBorder BackgroundColor="{AppThemeBinding Light={StaticResource Separator_Light}, Dark={StaticResource Separator_Dark}}" 
                                     HeightRequest="2" 
                                     BorderThickness="0" 
                                     Margin="0,10,0,0"/>
                    </dx:DXStackLayout>
                </DataTemplate>
            </dx:DXCollectionView.ItemTemplate>
        </dx:DXCollectionView>
    </Grid>
</ContentPage>
