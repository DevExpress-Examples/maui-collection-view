<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:model="clr-namespace:CrudOperations.Model"
             x:Class="CrudOperations.ContactEditingPage" 
             Title="Edit contact">
    <ContentPage.Triggers>
        <DataTrigger Binding="{Binding IsNew}" Value="True" TargetType="ContentPage">
            <Setter Property="Title" Value="Add new contact"/>
            <Setter Property="IsVisible" Value="False" TargetName="image"/>
        </DataTrigger>
    </ContentPage.Triggers>
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="savechanges" 
                     Clicked="SaveItemClick" />
    </ContentPage.ToolbarItems>
    <dx:DXScrollView>
        <dx:DXStackLayout BackgroundColor="{dx:ThemeColor Surface}"
                          Padding="0, 10, 0, 0">
            <dx:DXImage Source="{Binding Item.PhotoImageSource}"
                        x:Name="image"
                        WidthRequest="100"
                        HeightRequest="100"
                        Margin="0,0,0,20">
                <dx:DXImage.Clip>
                    <EllipseGeometry RadiusX="50" 
                                     RadiusY="50" 
                                     Center="50, 50" />
                </dx:DXImage.Clip>
            </dx:DXImage>
            <dx:DataFormView x:Name="dataForm" 
                             DataObject="{Binding Item}"
                             EditorLabelColor="{dx:ThemeColor Primary}" 
                             IsAutoGenerationEnabled="False"
                             EditorLabelWidth="40" 
                             ValidateProperty="OnDataFormValidateProperty"
                             Margin="0,10,0,0">
                <dx:DataFormTextItem FieldName="FirstName" 
                                     LabelIcon="collectionview_crud_name"
                                     LabelWidth="40"
                                     LabelText="" 
                                     InplaceLabelText="First Name" 
                                     IsInplaceLabelFloating="True" />
                <dx:DataFormTextItem FieldName="LastName" 
                                     IsLabelVisible="True" 
                                     LabelText=""
                                     InplaceLabelText="Last Name" 
                                     IsInplaceLabelFloating="True" />
                <dx:DataFormMaskedItem FieldName="HomePhone" 
                                       Keyboard="Telephone" 
                                       Mask="+1 (000) 000-0000"
                                       IsLabelVisible="True" 
                                       LabelIcon="editorsphone"
                                       InplaceLabelText="Phone" 
                                       IsInplaceLabelFloating="True" />
                <dx:DataFormTextItem FieldName="Email" 
                                     IsLabelVisible="True"
                                     LabelIcon="editorsemail"
                                     InplaceLabelText="Email" 
                                     IsInplaceLabelFloating="True" />
                <dx:DataFormTextItem FieldName="Company" IsLabelVisible="True"
                                     LabelIcon="editorscompany"
                                     InplaceLabelText="Company" IsInplaceLabelFloating="True" />
                <dx:DataFormTextItem FieldName="State" 
                                     IsLabelVisible="True"
                                     LabelIcon="editorslocation"
                                     InplaceLabelText="State" 
                                     IsInplaceLabelFloating="True" />
                <dx:DataFormTextItem FieldName="City" 
                                     IsLabelVisible="True" 
                                     LabelText=""
                                     InplaceLabelText="City" 
                                     IsInplaceLabelFloating="True" />
                <dx:DataFormTextItem FieldName="Address" 
                                     IsLabelVisible="True" 
                                     LabelText=""
                                     InplaceLabelText="Street" 
                                     IsInplaceLabelFloating="True" />
                <dx:DataFormNumericItem FieldName="ZipCode" 
                                        IsLabelVisible="True" 
                                        LabelText=""
                                        InplaceLabelText="Zip" 
                                        IsInplaceLabelFloating="True" />
            </dx:DataFormView>
        </dx:DXStackLayout>
    </dx:DXScrollView>
</ContentPage>
